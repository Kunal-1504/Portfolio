# Server only. Never use a NEXT_PUBLIC_ prefix for credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Alternatively, set GROQ_API_KEY and AI_MODEL (e.g. openai/gpt-oss-20b).
# GROQ_API_KEY=
# Or Gemini's OpenAI-compatible endpoint:
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash
# With no key, show the interactive explorer and an AI-disconnected notice.
# Set true only to explicitly enable prepared demo answers.
CHAT_DEMO_MODE=false
# Set to the final Vercel/custom domain, with https://, for canonical/OG URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional split hosting: GitHub Pages frontend calls a public Next.js backend.
# NEXT_PUBLIC_API_BASE_URL=https://your-backend.vercel.app
# ALLOWED_WEB_ORIGIN=https://kunal-1504.github.io
