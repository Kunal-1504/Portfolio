{
  "name": "kunal-deshmukh-portfolio",
  "version": "1.0.0",
  "description": "Kunal Deshmukh — AI/ML Engineer Portfolio (Dynamic Node.js + Express)",
  "main": "server.js",
  "scripts": {
    "start":       "node server.js",
    "dev":         "nodemon server.js",
    "pm2:start":   "npx pm2 start server.js --name portfolio",
    "pm2:stop":    "npx pm2 stop portfolio",
    "pm2:restart": "npx pm2 restart portfolio",
    "pm2:logs":    "npx pm2 logs portfolio",
    "pm2:save":    "npx pm2 save",
    "pm2:status":  "npx pm2 list"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "pm2": "^7.0.4"
  },
  "keywords": [
    "portfolio",
    "ai",
    "ml",
    "node",
    "express"
  ],
  "author": "Kunal Deshmukh <deshmukhkunal556@gmail.com>",
  "license": "MIT"
}
